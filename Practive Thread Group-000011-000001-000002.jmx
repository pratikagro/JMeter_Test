            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters">myCounter</stringProp>
            <stringProp name="script">String myCounter = vars.get(&quot;myCounter&quot;);
System.out.println(&quot;my Counter is :&quot; +myCounter);
log.info(&quot;my Counter is: &quot; + myCounter);
</stringProp>
            <stringProp name="scriptLanguage">java</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
